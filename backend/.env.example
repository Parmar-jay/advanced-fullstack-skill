# ═══════════════════════════════════════════════════════
#  COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# ═══════════════════════════════════════════════════════

# ── Database ──
MONGODB_URI=mongodb://localhost:27017
DB_NAME=myapp

# ── JWT ──
# IMPORTANT: Generate strong secrets (e.g. openssl rand -hex 32)
JWT_SECRET=change-this-to-a-strong-32-char-minimum-secret-key
JWT_REFRESH_SECRET=change-this-different-refresh-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# ── Google OAuth (optional) ──
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── SMTP Email ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=MyApp
SMTP_FROM_EMAIL=noreply@myapp.com

# ── OTP Settings ──
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# ── Login Security ──
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Cloudinary (file uploads — optional) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── App ──
APP_NAME=MyApp
APP_ENV=development
DEBUG=true
